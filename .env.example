NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only database credentials. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-server-secret-key
# Enable only after SMTP and the six-digit email template have been verified.
AUTH_EMAIL_OTP_ENABLED=false
# Enable after the Google OAuth client and Supabase provider/redirects are configured.
AUTH_GOOGLE_ENABLED=false
APP_ORIGIN=http://127.0.0.1:3100
# Production defaults to Secure cookies. Set false only for an HTTP loopback preview.
# AUTH_COOKIE_SECURE=false

# Pause account writes during an approved storage cutover; local drafts remain usable.
PROJECT_WRITES_PAUSED=false
